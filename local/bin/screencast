#!/usr/bin/env bash

set -- $(getopt -o b:m:siprhw -l begin:,mode:,stop,pause,resume,info,help,watch -- "$@")

display_help() {
  cat << 'EOF'
'sc' - Screencast with ffmpeg.

Usage:
  sc [OPTIONS]

Options:
  -b, --begin <file> Start the screencast. <file> must be a video format.
                     If an extension is not provided '.mkv' will be used.

  -h, --help Display this help.

  -i, --info Display info about current recording.

  -m, --mode <mode> Set recording mode with '--begin', and '--resume'.
                      * '0' Record screen and sink (default).
                      * '1' Record screen, sink and source.
                      * '2' Record screen, and source.

  -p, --pause Pause an ongoing recording.

  -r, --resume Resume a paused recording.

  -s, --stop Kill all ffmpeg processes.

  -w, --watch Watch a screencast.
EOF
}

get_device_name() {
    pactl list "$1" | awk -v name="$2" '
        /^[[:space:]]*Name: / {
            n = $0
            sub(/^[[:space:]]*Name: /, "", n)
            found = (n == name)
        }
        found && /^[[:space:]]*Description: / {
            sub(/^[[:space:]]*Description: /, "")
            print
            exit
        }
    '
}


watch_recording() {
    selection=$(fd -I -t f . "$SCREENCAST_DIR" -x basename | fzf) || exit 1
    mpv "${SCREENCAST_DIR}/${selection}" &
}


start_recording () {
    if [ -z "$filename" ]; then
        echo "Filename not specified. Aborting..."
        return 1
    fi

    if [[ "$(basename -- "$filename")" != *.* ]]; then
        filename="$filename.mkv"
    fi

    output="${SCREENCAST_DIR}/${filename}"

    if [[ -e "$output" ]]; then
        read -r -p "'$output' already exists. Overwrite? [y/N]? " answer
        [[ "$answer" =~ ^[yY]$  ]] || return 1
    fi

    read W H X Y <<< $(xrandr | awk '/ primary / { split($4,a,"[+x]"); print a[1], a[2], a[3], a[4] }')

    if [ -d "$metadata" ]; then
        msg="Recording resumed"
    else
        mkdir -p "${metadata}"
        msg="Recording started"
    fi

    local audio_sink="$(pactl get-default-sink)"
    local audio_source="$(pactl get-default-source)"
    local source_name=$(get_device_name sources $audio_source)
    local sink_name=$(get_device_name sinks $audio_sink)

    printf 'title=%s\nresolution=%sx%s\nfilepath=%s\n' \
        "$filename" "$W" "$H" "$output" > "$metadata/info"

    if [ $mode = 1 ]; then
        # WARN: This assumes if the source and sink are the same devices then it
        # is a bluetooth device.
        if [[ "$source_name" = "$sink_name" ]]; then
            local mac_addr=${audio_source#bluez_input.}
            local card=bluez_card.${mac_addr//:/_}
            pactl set-card-profile $card headset-head-unit 
            echo $card > $metadata/card
            echo $source_name profile set to headset-head-unit
            echo WARN: This does not guarantee audio. Do a screencast check first.
        fi
        echo source=${source_name} >> ${metadata}/info
        echo sink=${sink_name} >> ${metadata}/info
        ffmpeg -y \
            -f x11grab \
            -r 30 \
            -s ${W}x${H} \
            -i :0.0+${X},${Y} \
            -f pulse \
            -i "${audio_source}" \
            -f pulse \
            -i "${audio_sink}.monitor" \
            -filter_complex "[1:a][2:a]amerge=inputs=2[a]" \
            -map 0:v \
            -map "[a]" \
            -c:v libx264  \
            -preset ultrafast \
            -pix_fmt yuv420p \
            -c:a aac \
            -strict experimental \
            "${output}" \
            -hide_banner \
            -loglevel error &
        echo $! > $metadata/pid.ffmpeg
    elif [[ "$mode" == 2 ]]; then
        echo source=${source_name} >> ${metadata}/info
        echo sink= >> ${metadata}/info
        ffmpeg -y \
            -f x11grab \
            -r 30 \
            -s ${W}x${H} \
            -i :0.0+${X},${Y} \
            -f pulse \
            -i "${source}" \
            -map 0:v \
            -map 1:a \
            -c:v libx264 \
            -preset ultrafast \
            -pix_fmt yuv420p \
            -c:a aac \
            "${output}" \
            -hide_banner \
            -loglevel error &
        echo $! > $metadata/pid.ffmpeg
    else
        echo source= >> ${metadata}/info
        echo sink=${sink_name} >> ${metadata}/info
        ffmpeg -y \
            -f x11grab \
            -r 30 \
            -s ${W}x${H} \
            -i :0.0+${X},${Y} \
            -f pulse -i "${sink}.monitor" \
            -map 0:v \
            -map 1:a \
            -c:v libx264 \
            -preset ultrafast \
            -pix_fmt yuv420p \
            -c:a aac \
            "${output}" \
            -hide_banner \
            -loglevel error &
        echo $! > $metadata/pid.ffmpeg
    fi

    echo $(date +'%s') > ${metadata}/starttime

    dm --msg "$msg"

    if [[ -f $metadata/elapsedtime ]]; then
        screencast_rec_timer.sh $(cat $metadata/elapsedtime) &
    else
        screencast_rec_timer.sh &
    fi

    REVERSETIMER_PID=$!
    echo $REVERSETIMER_PID > $metadata/pid.recording_timer

}


pause_recording() {
    if [[ -d "$metadata" ]] && pgrep ffmpeg > /dev/null
    then
        if [[ -f $metadata/elapsedtime ]]; then
            elapsed_time=$(( $(date +'%s') - $(< $metadata/starttime) + $(< $metadata/elapsedtime) ))
        else
            elapsed_time=$(( $(date +'%s') - $(< $metadata/starttime) ))
        fi
        echo $elapsed_time > $metadata/elapsedtime
        pkill ffmpeg
        while pgrep ffmpeg > /dev/null; do sleep 0.1; done
        [[ -f $metadata/pid.recording_timer ]] && kill -HUP "$(cat "$metadata/pid.recording_timer")" >/dev/null 2>&1

        dm --msg "Recording paused"

        screencast_rec_timer.sh -P $(cat $metadata/elapsedtime) &
        REVERSETIMER_PID=$!
        echo $REVERSETIMER_PID > $metadata/pid.recording_timer

        echo paused=true >> $metadata/info
    else
        dm --msg "Nothing to pause"
        exit 1
    fi
}


resume_recording() {
    if [[ -d "$metadata" ]] && grep -q paused=true ${metadata}/info
    then
        fp=$(grep filepath ${metadata}/info | cut -d '=' -f 2)
        echo ${fp} >> ${metadata}/mergelist.txt
        filename="$(grep title= ${metadata}/info | cut -d '=' -f 2 | cut -d. -f1 | cut -d '_' -f 1)_$(date +'%s').mkv"
        grep -q 'source=' ${metadata}/info && mode=1 || mode=0
        [[ -f $metadata/pid.recording_timer ]] && kill -HUP "$(cat "$metadata/pid.recording_timer")" >/dev/null 2>&1
        start_recording # again
    else
        dm --msg "Nothing to resume"
        exit 1
    fi
}


stop_recording () {

    if [[ ! -d $metadata ]]; then
        dm --msg "Nothing to stop"
        return 1
    fi

    local ffmpeg_pid=$(<$metadata/pid.ffmpeg)
    local recording_timer_pid=$(<$metadata/pid.recording_timer)

    kill $ffmpeg_pid
    echo finishing current screencast
    # NOTE: Wait ffmpeg to close gracefully, wait till it finishes correctly and completely.
    while kill -0 $ffmpeg_pid 2>/dev/null; do
        sleep 0.5 
    done


    kill -HUP $recording_timer_pid
    dm --msg "Recording stopped"

    if [ -f $metadata/card ]; then
        card=$(<$metadata/card)
        pactl set-card-profile $card a2dp-sink
        echo $card profile set to a2dp-sink
    fi

    if [ -f ${metadata}/mergelist.txt ]; then
        fp=$(grep filepath ${metadata}/info | cut -d '=' -f 2)
        echo ${fp} >> ${metadata}/mergelist.txt
        sed -i "s|^|file '|; s|$|'|" ${metadata}/mergelist.txt
        fp="${SCREENCAST_DIR}/final_$(date +'%s').mkv"
        if ffmpeg -f concat -safe 0 -i ${metadata}/mergelist.txt \
            -c copy -movflags +faststart "${fp}" -hide_banner -loglevel error; then
            filename=$(head -1 ${metadata}/mergelist.txt | cut -d ' ' -f 2)
            filename="${filename//[\"\']/}"
            sed 's/^file/rm/g' ${metadata}/mergelist.txt | bash
            mv ${fp} ${filename}
            echo "Recording saved to '`realpath ${filename}`'"
        else
            echo Concatnating files with ffmpeg has failed. May require manual intervention.
            return 1
        fi
    fi
    rm -r $metadata
}


show_status() {
    if [ -d ${metadata} ]; then
        cat ${metadata}/info
        if [ -f ${metadata}/mergelist.txt ]; then
            echo
            echo --- MERGE LIST ---
            nl ${metadata}/mergelist.txt
        fi
    else
        dm --msg "Nothing to show"
        exit 1
    fi

}


SCREENCAST_DIR="${HOME}/Videos/screencasts"
metadata="/tmp/screencast.${USER}"

if [ ! -d "${SCREENCAST_DIR}" ]
then
    mkdir -p "${SCREENCAST_DIR}"
fi

set_action() {
    if [ -n "$action" ]; then 
         echo "Error: conflicting actions '$action' and '$1'"
         exit 1
    fi

    action="$1"
}


while [ -n "$1" ]; do
    case "$1" in
        -b|--begin)  
            set_action "begin"
            filename="${2//[\"\']/}"
            shift 2 
            ;;

        -m|--mode)   
            mode="${2//[\"\']/}";
            shift 2 
            ;;

        -s|--stop)   
            set_action "stop"
            shift 
            ;;

        -p|--pause)  
            set_action "pause"
            shift 
            ;;

        -r|--resume) 
            set_action "resume"
            shift 
            ;;

        -i|--info)
            set_action "info"
            shift 
            ;;

        -w|--watch)
            set_action "watch"
            shift 
            ;;

        -h|--help)   
            display_help
            exit 0 
            ;;

        --)
            shift 
            break
            ;;
        *)
            display_help
            exit 1 
            ;;
    esac
done

# declare -rA bluetooth_devices=(
#   ["JBL Clip 4"]="F8:5C:7D:AC:31:F9"
#   ["soundcore H30i"]="F4:B6:2D:08:0C:EA"
#   ["WI-C100"]="74:B7:E6:29:ED:B2"
#   ["soundcore Liberty 4 NC"]="E8:26:CF:26:98:1A"
# )

declare -A actions=(
    [begin]="start_recording"
    [stop]="stop_recording"
    [pause]="pause_recording"
    [resume]="resume_recording"
    [info]="show_status"
    [watch]="watch_recording"
)

${actions[$action]}
