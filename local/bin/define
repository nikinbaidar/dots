#!/usr/bin/env bash

readonly WIN_GEOM="80x30"

show_definition() {
    local raw 
    local word 
    local body 
    local cols 
    local width 
    local pad="  "

    raw=$(xclip -o -selection clipboard)
    # Keeps only the first whitespace-separated token, stripped to letters,
    # apostrophes and hyphens. Empty output means "no usable word".
    word=${raw//[^[:alpha:]\'-]/}
    [[ -z $word ]] && return 1

    cols=$(tput cols)
    width=$(( cols - ${#pad} - 1 ))

    body=$(dict -d wn "$word" 2>/dev/null | awk -v W="$width" -v P="$pad" '
        BEGIN {
            name["n"] = "noun";      name["v"] = "verb"
            name["a"] = "adjective"; name["s"] = "adjective"
            name["adj"] = "adjective"
            name["r"] = "adverb";    name["adv"] = "adverb"
        }
        function emit(   n, i, w, vis, len, plen, dim, line) {
            if (!inSense) return
            plen = length(P) + 4
            line = P sprintf("%-3s", lab) " "
            len = plen; dim = 0
            n = split(cur, words, " ")
            for (i = 1; i <= n; i++) {
                w = words[i]; vis = length(w)
                if (len > plen && len + 1 + vis > W) {
                    print line
                    line = sprintf("%*s", plen, ""); len = plen
                } else if (len > plen) {
                    line = line " "; len++
                }
                line = line w
                len += vis
            }
            print line
            print ""
            inSense = 0; cur = ""
        }
        /^[ \t]+((adj|adv|n|v|a|s|r) )?[0-9]+:/ {
            emit()
            match($0, /^[ \t]+((adj|adv|n|v|a|s|r) )?[0-9]+:/)
            lab = substr($0, 1, RLENGTH)
            gsub(/[: \t]+$/, "", lab); gsub(/^[ \t]+/, "", lab)
            split(lab, parts, " ")
            if (parts[1] in name) {
                pos = name[parts[1]]
                if (pos != curpos) {
                    print P "\033[1;35m" pos "\033[0m"
                    print ""
                    curpos = pos
                }
                lab = parts[2]
            } else {
                lab = parts[1]
            }
            lab = lab "."
            cur = substr($0, RLENGTH + 1)
            inSense = 1
            next
        }
        /^[ \t]+[^ \t]/ {
            if (!inSense) next
            t = $0; sub(/^[ \t]+/, "", t)
            cur = cur " " t
            next
        }
        { emit() }
        END { emit() }
    ')

    if [[ -z $body ]]; then
        clear
        printf '\n%s\e[1;36m%s\e[0m\n\n' "$pad" "${word,,}"
        printf '%sNo definition found in WordNet.\n\n' "$pad"
        read -p "${pad}Search online? [N/y] " -n 1 ans
        if [[ ${ans} == "y" ]]; then
            if pgrep firefox > /dev/null; then
                firefox-developer-edition \
                    "https://dictionary.cambridge.org/dictionary/english/${raw,,}"
            else
                setsid -f firefox-developer-edition \
                    "https://dictionary.cambridge.org/dictionary/english/${raw,,}"
            fi
        fi
        return 0
    fi

    tput smcup
    clear
    {
        printf '\n%s\e[1;36m%s\e[0m\n\n' "$pad" "${word,,}"
        printf '%s\n' "$body"
    } | less -R -X
    tput rmcup
}

export -f show_definition

wid=$(xdotool getmouselocation --shell | awk -F= '/WINDOW/{print $2}')
wid=$(xprop -id "$wid" WM_CLASS | awk '{print $NF}')
wid=${wid//\"/}

case "$wid" in
    st*|sioyek) 
        # WARN: Clipboard preservation does not work with sioyek and st.
        ;;
    *)
        xclip -o -selection clipboard > /tmp/clip.old
        sleep 0.5
        xdotool key --clearmodifiers ctrl+c
        ;;
esac

st -c "Lehte" -T "Lehte" -n "Terminal" -g ${WIN_GEOM} \
    bash -c "show_definition"

# Restore the user's previous clipboard contents so we don't clobber it.
if [[ -f /tmp/clip.old ]] then
    xclip -selection clipboard < /tmp/clip.old
    rm /tmp/clip.old
fi
