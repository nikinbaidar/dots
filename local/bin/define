#!/usr/bin/env bash

readonly WIN_GEOM="80x30"

show_definition() {
    local word 
    local body 
    local cols 
    local width 
    local pad="  "

    word=$(xclip -o -selection clipboard)
    # NOTE: Remove surrounding white-space and trailing dots, commas and
    # semicolons.
    word="${word,,}"
    word="${word#"${word%%[![:space:]]*}"}"
    word="${word%"${word##*[![:space:]]}"}"
    word="${word%[.,;]}"

    [[ -z $word ]] && return 1

    cols=$(tput cols)
    width=$(( cols - ${#pad} - 1 ))

    body=$(dict -h 127.0.0.1 -d wn "$word" 2>/dev/null | awk -v W="$width" -v P="$pad" '
        BEGIN {
            name["n"] = "noun";      name["v"] = "verb"
            name["a"] = "adjective"; name["s"] = "adjective"
            name["adj"] = "adjective"
            name["r"] = "adverb";    name["adv"] = "adverb"
        }
        function emit(   n, i, w, vis, len, plen, dim, line) {
            if (!inSense) return
            plen = length(P) + 4
            line = P sprintf("%-3s", lab) " "
            len = plen; dim = 0
            n = split(cur, words, " ")
            for (i = 1; i <= n; i++) {
                w = words[i]; vis = length(w)
                if (len > plen && len + 1 + vis > W) {
                    print line
                    line = sprintf("%*s", plen, ""); len = plen
                } else if (len > plen) {
                    line = line " "; len++
                }
                line = line w
                len += vis
            }
            print line
            print ""
            inSense = 0; cur = ""
        }
        /^[ \t]+((adj|adv|n|v|a|s|r) )?[0-9]+:/ {
            emit()
            match($0, /^[ \t]+((adj|adv|n|v|a|s|r) )?[0-9]+:/)
            lab = substr($0, 1, RLENGTH)
            gsub(/[: \t]+$/, "", lab); gsub(/^[ \t]+/, "", lab)
            split(lab, parts, " ")
            if (parts[1] in name) {
                pos = name[parts[1]]
                if (pos != curpos) {
                    print P pos
                    print ""
                    curpos = pos
                }
                lab = parts[2]
            } else {
                lab = parts[1]
            }
            lab = lab "."
            cur = substr($0, RLENGTH + 1)
            inSense = 1
            next
        }
        /^[ \t]+[^ \t]/ {
            if (!inSense) next
            t = $0; sub(/^[ \t]+/, "", t)
            cur = cur " " t
            next
        }
        { emit() }
        END { emit() }
    ')

    if [[ -z $body ]]; then
        clear
        printf '\n%s%s\n\n' "$pad" "${word,,}"
        printf '%sNo definition found in WordNet.\n\n' "$pad"
        read -p "${pad}Search online? [N/y] " -n 1 ans
        if [[ ${ans} == "y" ]]; then
            url="https://dictionary.cambridge.org/dictionary/english/${word}"
            if pgrep firefox > /dev/null
            then
                firefox-developer-edition "$url"
            else
                setsid -f firefox-developer-edition "$url"
            fi
        fi
        return 0
    fi

    tput smcup
    clear
    {
        printf '\n%s%s\n\n' "$pad" "${word,,}"
        printf '%s\n' "$body"
    } | less -RXc
    tput rmcup
}

export -f show_definition

wid=$(xdotool getmouselocation --shell | awk -F= '/WINDOW/{print $2}')
class=$(xprop -id "$wid" WM_CLASS | awk '{print $NF}')
class=${class//\"/}
if [[ $class != st* ]]; then
    # WARN: Clipboard preservation does not work with st.
    saved=$(xclip -o -selection clipboard 2> /dev/null)
    xdotool key --clearmodifiers ctrl+c
    sleep 0.20
fi

st -c Lehte -T Lehte -n Terminal -g ${WIN_GEOM} bash -c show_definition

# Restore saved clipboard
[[ -n $saved ]] && printf '%s' "$saved" | xclip -selection clipboard
